# nack-file: NACK's control-loop reconcilers reading resources from a directory.
FROM golang:1.27.0-alpine AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY pkg/ pkg/
COPY internal/ internal/
COPY controllers/ controllers/
RUN CGO_ENABLED=0 go build -o nack-file ./cmd/nack-file

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /workspace/nack-file /nack-file
USER 65532:65532
ENTRYPOINT ["/nack-file"]
